<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/DialogueStyles.uss?fileID=7433441132597879392&amp;guid=919e501be3808c044bd1a21c94d8d1a8&amp;type=3#DialogueStyles"/>
    <Style src="project://database/Assets/UI%20Toolkit/ComponentsTweaks.uss?fileID=7433441132597879392&amp;guid=2d1de6111522b504e8623c33697fa89a&amp;type=3#ComponentsTweaks"/>
    <ui:VisualElement name="" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); margin-top: 600px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;">
        <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
            <ui:VisualElement name="VisualElement" style="flex-grow: 0; flex-shrink: 0; height: 50px; background-color: rgba(0, 0, 0, 0.63); width: 500px; border-top-left-radius: 0; border-top-right-radius: 20px; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                <ui:Label text="NpcName" name="NpcName" double-click-selects-word="false" style="flex-shrink: 1; flex-grow: 1; color: rgb(0, 0, 0); -unity-text-align: middle-left; font-size: 25px; margin-top: 10px; margin-right: 10px; margin-bottom: 0; margin-left: 10px; -unity-font-definition: url(&quot;project://database/Assets/_Game/Prefabs/UI/Fonts/bedstead.otf?fileID=12800000&amp;guid=5c670b434ca74524386dd732ddcb8661&amp;type=3#bedstead&quot;); -unity-text-auto-size: best-fit 10px 25px; -unity-text-generator: advanced; background-color: rgb(251, 184, 0); padding-top: 5px; padding-right: 10px; padding-bottom: 5px; padding-left: 10px; border-top-left-radius: 0; border-top-right-radius: 15px; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Split" style="flex-grow: 1;"/>
            <ui:VisualElement name="CloseButtonBase" style="flex-grow: 0; flex-shrink: 0; height: 50px; background-color: rgba(0, 0, 0, 0.63); width: 150px; border-top-left-radius: 20px; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; align-self: auto; align-items: center;">
                <ui:Button text="Koniec" name="CloseButton" class="closeButton" style="margin-top: 10px; margin-right: 10px; margin-bottom: 0; margin-left: 10px; border-top-left-radius: 15px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MainDialogueBase" style="flex-grow: 1; flex-shrink: 1; background-color: rgba(0, 0, 0, 0.63); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;">
            <ui:VisualElement name="NpcPartBase" style="flex-grow: 0; margin-top: 10px; margin-right: 10px; margin-bottom: 5px; margin-left: 10px; flex-shrink: 0; height: 150px; background-color: rgb(24, 24, 24); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                <ui:Label text="NpcPart" name="NpcPart" style="color: rgb(255, 255, 255); font-size: 30px; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/_Game/Prefabs/UI/Fonts/bedstead.otf?fileID=12800000&amp;guid=5c670b434ca74524386dd732ddcb8661&amp;type=3#bedstead&quot;); white-space: normal; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; -unity-text-auto-size: best-fit 10px 30px; -unity-text-generator: advanced;"/>
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; margin-top: 0; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; flex-shrink: 1; height: auto; background-color: rgb(24, 24, 24); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                <ui:ListView name="OptionsList" style="flex-grow: 1; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; display: flex; flex-shrink: 1; min-height: auto; max-height: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
