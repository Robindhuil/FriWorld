                <ui:Label text="Label" name="QuestName" style="font-size: 23px; -unity-font-definition: url(&quot;project://database/Assets/!/Prefabs/UI/Fonts/bedstead.otf?fileID=12800000&amp;guid=5c670b434ca74524386dd732ddcb8661&amp;type=3#bedstead&quot;); color: rgb(251, 184, 0); -unity-font-style: bold; -unity-text-align: middle-left; margin-top: 5px; margin-right: 5px; margin-bottom: 0; margin-left: 5px; padding-top: 5px; padding-right: 10px; padding-bottom: 5px; padding-left: 10px; background-color: rgb(24, 24, 24); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-text-auto-size: best-fit 10px 23px; -unity-text-generator: advanced; white-space: nowrap;"/>
